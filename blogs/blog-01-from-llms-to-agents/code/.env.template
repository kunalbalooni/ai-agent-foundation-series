# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit your real credentials.

# Azure OpenAI resource endpoint
# Format: https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key
AZURE_OPENAI_API_KEY=

# Name of the deployed model (e.g. gpt-4o-mini, gpt-4o)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Azure OpenAI API version — check the model availability page for supported versions
# https://learn.microsoft.com/azure/ai-services/openai/concepts/models
AZURE_OPENAI_API_VERSION=2025-01-01-preview
