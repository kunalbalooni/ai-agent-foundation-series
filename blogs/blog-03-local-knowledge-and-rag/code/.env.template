# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit your real credentials.

# Azure OpenAI resource endpoint
# Format: https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API key
AZURE_OPENAI_API_KEY=

# Name of the deployed chat model (e.g. gpt-4o-mini, gpt-4o)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Name of the deployed embedding model (e.g. text-embedding-3-small, text-embedding-3-large)
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
